<Page x:Class="TrailMeister.GUI.Main.PageAllData"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TrailMeister.GUI.Main"
      xmlns:converters="clr-namespace:TrailMeisterUtilities.Converters;assembly=TrailMeisterUtilities"
      xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="All Data">

    <Page.Resources>
        <CollectionViewSource x:Key="cvsData" Source="{Binding AllParticipants}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="LapCount" Direction="Descending"/>
                <scm:SortDescription PropertyName="TimeTotal" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <converters:Tag2PersonConverter x:Key="Tag2PersonConverter"/>
    </Page.Resources>

    <Grid Margin="16,16,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="DataGridRecentLaps"
                  ItemsSource="{Binding Source={StaticResource cvsData}}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  Grid.Row="0" GridLinesVisibility="All"
                  IsSynchronizedWithCurrentItem="False" FontSize="24"
                  ColumnHeaderStyle="{StaticResource DataGridHeaderRight}">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="colName" FontSize="48" CanUserResize="False" Width="4*"
                                    Header="Name" MinWidth="450"
                                    HeaderStyle="{StaticResource DataGridHeaderLeft}"
                                    ElementStyle="{StaticResource DataGridCellLeft}">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource Tag2PersonConverter}">
                            <Binding Path="PersonId"/>
                            <Binding Path="DataContext.AllPeople" RelativeSource="{RelativeSource AncestorType=DataGrid}"/>
                            <Binding Source="{x:Static converters:NameConversionType.First}"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="colLapCount" Width="1*" Header="Lap"
                                    Binding="{Binding LapCount}" FontSize="48" MinWidth="50"
                                    ElementStyle="{StaticResource DataGridCellRight}"/>

                <DataGridTextColumn x:Name="colLapTime" CanUserResize="False" Width="3*"
                                    Header="Last Lap" Binding="{Binding TimeLap}" FontSize="48" MinWidth="300"
                                    ElementStyle="{StaticResource DataGridCellRight}"/>

                <DataGridTextColumn x:Name="colBestLapTime" CanUserResize="False" Width="3*"
                                    Header="Best Lap" Binding="{Binding BestLapTime}" FontSize="48" MinWidth="300"
                                    ElementStyle="{StaticResource DataGridCellRight}"/>

                <DataGridTextColumn x:Name="colAvgLapTime" CanUserResize="False" Width="3*"
                                    Header="Avg Lap Time" Binding="{Binding AverageLapTime}" FontSize="48" MinWidth="300"
                                    ElementStyle="{StaticResource DataGridCellRight}"/>

                <DataGridTextColumn x:Name="colTotalTime" CanUserResize="False" Width="3*"
                                    Header="Total Time" Binding="{Binding TimeTotal}" FontSize="48" MinWidth="300"
                                    ElementStyle="{StaticResource DataGridCellRight}"/>
            </DataGrid.Columns>
        </DataGrid>

        <CheckBox x:Name="EventFinish" Grid.Row="1"
                  Content="Event now finished" IsChecked="{Binding IsEventFinished}"
                  Foreground="{StaticResource NavyBrush}" FontSize="18" Margin="0,8,0,0"/>
    </Grid>
</Page>
