<Page x:Class="TrailMeister.GUI.Main.PageOneArrival"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:TrailMeister.GUI.Main"
      xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
      xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
      xmlns:converters="clr-namespace:TrailMeisterUtilities.Converters;assembly=TrailMeisterUtilities"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="One Arrival">

    <Page.Resources>
        <converters:Tag2PersonConverter x:Key="Tag2PersonConverter"/>
    </Page.Resources>

    <Grid Margin="16,16,16,16">
        <!-- Name of the most recent arrival -->
        <Label diag:PresentationTraceSources.TraceLevel="High"
               x:Name="lblName"
               HorizontalAlignment="Center" VerticalAlignment="Top"
               Width="1180" Height="160" FontSize="80"
               Foreground="{StaticResource NavyBrush}">
            <Label.Content>
                <MultiBinding Converter="{StaticResource Tag2PersonConverter}">
                    <Binding Path="MostRecent.PersonId"/>
                    <Binding Path="AllPeople"/>
                </MultiBinding>
            </Label.Content>
        </Label>

        <!-- Row labels -->
        <Label x:Name="lblLapCount"       Content="Laps:"       HorizontalAlignment="Left" Margin="10,164,0,0"  VerticalAlignment="Top" Width="384" Height="120" FontSize="80" Foreground="{StaticResource NavyBrush}"/>
        <Label x:Name="lblLapTime"        Content="Last Lap:"   HorizontalAlignment="Left" Margin="10,274,0,0"  VerticalAlignment="Top" Width="384" Height="120" FontSize="80" Foreground="{StaticResource NavyBrush}"/>
        <Label x:Name="lblAverageLapTime" Content="Avg Lap:"    HorizontalAlignment="Left" Margin="10,384,0,0"  VerticalAlignment="Top" Width="384" Height="120" FontSize="80" Foreground="{StaticResource NavyBrush}"/>
        <Label x:Name="lblBestTime"       Content="Best Lap:"   HorizontalAlignment="Left" Margin="10,494,0,0"  VerticalAlignment="Top" Width="384" Height="120" FontSize="80" Foreground="{StaticResource NavyBrush}"/>
        <Label x:Name="lblTotalTime"      Content="Total Time:" HorizontalAlignment="Left" Margin="10,604,0,0"  VerticalAlignment="Top" Width="384" Height="120" FontSize="80" Foreground="{StaticResource NavyBrush}"/>

        <!-- Row values -->
        <Label x:Name="lblLapCountCount"      Content="{Binding MostRecent.LapCount}"       HorizontalAlignment="Center" HorizontalContentAlignment="Right" Margin="0,164,0,0"    VerticalAlignment="Top" Width="324" Height="120" FontSize="80" Foreground="{StaticResource NavyBrush}"/>
        <Label x:Name="lblLapTimeTime"        Content="{Binding MostRecent.TimeLap}"         HorizontalAlignment="Left"   HorizontalContentAlignment="Right" Margin="438,274,0,0"  VerticalAlignment="Top" Width="620" Height="120" FontSize="80" Foreground="{StaticResource NavyBrush}"/>
        <Label x:Name="lblAverageLapTimeTime" Content="{Binding MostRecent.AverageLapTime}"  HorizontalAlignment="Left"   HorizontalContentAlignment="Right" Margin="438,384,0,0"  VerticalAlignment="Top" Width="620" Height="120" FontSize="80" Foreground="{StaticResource NavyBrush}"/>
        <Label x:Name="lblBestTimeTime"       Content="{Binding MostRecent.BestLapTime}"     HorizontalAlignment="Left"   HorizontalContentAlignment="Right" Margin="438,494,0,0"  VerticalAlignment="Top" Width="620" Height="120" FontSize="80" Foreground="{StaticResource NavyBrush}"/>
        <Label x:Name="lblTotalTimeTime"      Content="{Binding MostRecent.TimeTotal}"       HorizontalAlignment="Left"   HorizontalContentAlignment="Right" Margin="438,604,0,0"  VerticalAlignment="Top" Width="620" Height="120" FontSize="80" Foreground="{StaticResource NavyBrush}"/>
    </Grid>
</Page>
