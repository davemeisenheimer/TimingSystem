<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Base styles ───────────────────────────────────────────────────── -->
    <Style x:Key="DataGridCellBase" TargetType="TextBlock">
        <Setter Property="Padding" Value="8 0 8 0"/>
    </Style>

    <Style x:Key="DataGridHeaderBase" TargetType="DataGridColumnHeader">
        <Setter Property="Background"             Value="{StaticResource CardHeaderBrush}"/>
        <Setter Property="Foreground"             Value="{StaticResource NavyBrush}"/>
        <Setter Property="FontWeight"             Value="SemiBold"/>
        <Setter Property="Padding"                Value="4"/>
    </Style>

    <!-- ── DataGrid cell text styles ─────────────────────────────────────── -->
    <Style x:Key="DataGridCellRight" TargetType="TextBlock" BasedOn="{StaticResource DataGridCellBase}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="DataGridCellLeft" TargetType="TextBlock" BasedOn="{StaticResource DataGridCellBase}">
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- ── DataGrid column header styles ─────────────────────────────────── -->
    <Style x:Key="DataGridHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderBase}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
    </Style>

    <Style x:Key="DataGridHeaderLeft" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridHeaderBase}">
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!-- ── DataGrid row style (hover + selection) ─────────────────────────── -->
    <Style x:Key="ThemedDataGridRow" TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CardHeaderBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource CardBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource NavyBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Implicit DataGrid style — alternating rows + row style ─────────── -->
    <Style TargetType="DataGrid">
        <Setter Property="RowBackground"            Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="RowStyle"                 Value="{StaticResource ThemedDataGridRow}"/>
    </Style>

    <!-- ── Implicit GroupBox style ────────────────────────────────────────── -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource NavyBrush}"/>
    </Style>

</ResourceDictionary>
