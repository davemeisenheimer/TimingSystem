<UserControl x:Class="TrailMeisterViewer.Windows.MainWindow.EventsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TrailMeisterViewer.Windows.MainWindow"
             xmlns:utils="clr-namespace:TrailMeisterUtilities;assembly=TrailMeisterUtilities"
             xmlns:converters="clr-namespace:TrailMeisterViewer.Converters"
             xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:CanDeleteEventToVisibilityConverter x:Key="CanDeleteEventToVisibilityConverter"/>
        <CollectionViewSource x:Key="SortedEvents" Source="{Binding AllEvents}">
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="EventDate" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <DataGrid x:Name="gridEvents"
                ItemsSource="{Binding Source={StaticResource SortedEvents}}"
                IsSynchronizedWithCurrentItem="False"
                FontSize="24" AutoGenerateColumns="False" GridLinesVisibility="All" HorizontalAlignment="Stretch"
                CanUserAddRows="False"
                ColumnHeaderStyle="{StaticResource DataGridHeaderRight}">

        <DataGrid.Resources>
            <utils:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        </DataGrid.Resources>

        <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
                <EventSetter Event="MouseDoubleClick" Handler="OnEventRowDoubleClick"/>
            </Style>
        </DataGrid.RowStyle>
        <DataGrid.Columns>
            <DataGridTextColumn x:Name="colID" CanUserResize="False" Width="1*" Header="ID" Binding="{Binding ID}" IsReadOnly="true" MinWidth="50"
                                ElementStyle="{StaticResource DataGridCellRight}"/>

            <DataGridTextColumn x:Name="colName" CanUserResize="False" Width="10*" Header="Event Name" Binding="{Binding EventName}" IsReadOnly="true" MinWidth="200"
                                HeaderStyle="{StaticResource DataGridHeaderLeft}"
                                ElementStyle="{StaticResource DataGridCellLeft}"/>

            <DataGridTextColumn x:Name="colDate" Width="4*" Header="Event Date" Binding="{Binding EventDate, StringFormat=d}" IsReadOnly="true" MinWidth="300"
                                ElementStyle="{StaticResource DataGridCellRight}"/>

            <DataGridTextColumn x:Name="colLapLength" Width="1*" Header="Lap Length" Binding="{Binding LapLength}" MinWidth="150"
                                ElementStyle="{StaticResource DataGridCellRight}"/>

            <DataGridTemplateColumn x:Name="colDeleteButton" Width="1*" Header="" IsReadOnly="false" MinWidth="48">
                <DataGridTemplateColumn.Visibility>
                    <Binding Source="{StaticResource VmProxy}"
                             Path="Data.DeleteColumnIsVisible"
                             Converter="{StaticResource Bool2VisibilityConverter}" />
                </DataGridTemplateColumn.Visibility>

                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <Button Width="24" Height="24" Padding="0" BorderThickness="0" Background="Transparent"
                                Command="{Binding DataContext.DeleteEventCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding ID}" Margin="4,4,4,4">
                            <Button.Visibility>
                                <Binding Path="."
                                         Converter="{StaticResource CanDeleteEventToVisibilityConverter}" />
                            </Button.Visibility>
                            <Image Source="pack://application:,,,/Assets/TrashIcon.png"
                                   Width="22" Height="22" Stretch="Uniform" />
                        </Button>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
