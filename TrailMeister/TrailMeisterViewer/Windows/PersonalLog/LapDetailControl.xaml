<UserControl x:Class="TrailMeisterViewer.Windows.PersonalLog.LapDetailControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TrailMeisterViewer.Windows.PersonalLog"
             xmlns:converters="clr-namespace:TrailMeisterUtilities.Converters;assembly=TrailMeisterUtilities">

    <UserControl.Resources>
        <converters:Person2NameConverter x:Key="Person2NameConverter"/>
        <converters:Ms2TimeConverter x:Key="Ms2TimeConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: name, event, summary -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,24,0">
                <Label FontSize="24" Padding="2">
                    <Label.Content>
                        <MultiBinding Converter="{StaticResource Person2NameConverter}">
                            <Binding Source="{x:Static converters:NameConversionType.FirstAndLast}" />
                            <Binding Path="RacerData.Person"/>
                        </MultiBinding>
                    </Label.Content>
                </Label>
                <Label FontSize="14" Content="{Binding RacerData.Person.NickName}" Foreground="Gray" Padding="2,0,2,2"/>
                <Label FontSize="18" Content="{Binding Event.EventName}" Padding="2"/>
                <Label FontSize="14" Content="{Binding Event.EventDate, StringFormat=d}" Foreground="Gray" Padding="2"/>
            </StackPanel>

            <local:SummaryGrid Grid.Column="2"
                               Label="Event Totals"
                               RacerData="{Binding RacerData}" />
        </Grid>

        <!-- Laps grid -->
        <DataGrid x:Name="lapsGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding RacerData.Laps}"
                  IsSynchronizedWithCurrentItem="False"
                  FontSize="24" AutoGenerateColumns="False" GridLinesVisibility="All"
                  HorizontalAlignment="Stretch" CanUserAddRows="False" CanUserSortColumns="True"
                  CellEditEnding="OnCellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Lap #" Width="2*" MinWidth="80"
                                    IsReadOnly="True"
                                    Binding="{Binding LapCount}"
                                    SortMemberPath="LapCount">
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="8 0 8 0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Lap Time" Width="4*" MinWidth="150"
                                    IsReadOnly="True"
                                    SortMemberPath="LapTime">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource Ms2TimeConverter}">
                            <Binding Path="LapTime"/>
                            <Binding Source="{x:Static converters:TimeConversionPrecision.ToTheHundredth}"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.HeaderStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="Padding" Value="8 0 8 0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Editable per-lap length override -->
                <DataGridTemplateColumn x:Name="colLapLength" Header="Lap Length (m)" Width="3*" MinWidth="120"
                                        SortMemberPath="LapLength">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>

                    <!-- Display: show override or event default in gray -->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Override value (shown when LapLength is set) -->
                                <TextBlock Text="{Binding LapLength}" HorizontalAlignment="Right" Padding="8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LapLength}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Event default placeholder (shown when LapLength is null) -->
                                <TextBlock Text="{Binding DataContext.Event.LapLength, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='({0})'}"
                                           Foreground="Gray" HorizontalAlignment="Right" Padding="8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LapLength}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <!-- Edit mode: plain TextBox, blank = use event default -->
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding LapLength, TargetNullValue='', Mode=OneWay}"
                                     HorizontalAlignment="Right" Padding="8,0"
                                     MinWidth="100"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
