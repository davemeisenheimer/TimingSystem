<UserControl x:Class="TrailMeisterViewer.Windows.PersonalLog.PersonalLogControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrailMeisterViewer.Windows.PersonalLog"
        xmlns:converters="clr-namespace:TrailMeisterUtilities.Converters;assembly=TrailMeisterUtilities">

    <UserControl.Resources>
        <DataTemplate x:Key="RacerLapsTooltipTemplate">
            <Border Background="LightYellow" Padding="5" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="Times for all laps" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding RacerData.Person.NickName}" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ItemsControl ItemsSource="{Binding RacerData.Laps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="Lap "/>
                                    <Run Text="{Binding LapCount, Mode=OneWay}"/>
                                    <Run Text=": "/>
                                    <Run>
                                        <Run.Text>
                                            <MultiBinding Converter="{StaticResource Ms2TimeConverter}" Mode="OneWay">
                                                <Binding Path="LapTime" />
                                                <Binding Source="{x:Static converters:TimeConversionPrecision.ToTheHundredth}" />
                                            </MultiBinding>
                                        </Run.Text>
                                    </Run>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="8"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    Margin="0,0,16,4" VerticalAlignment="Stretch">
                <StackPanel>
                    <Border Background="{StaticResource CardHeaderBrush}" CornerRadius="8,8,0,0" Padding="10,6">
                        <TextBlock Text="Racer" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource NavyBrush}" TextAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,6,10,8">
                        <Label FontSize="24" Padding="2">
                            <Label.Content>
                                <MultiBinding Converter="{StaticResource Person2NameConverter}">
                                    <Binding Source="{x:Static converters:NameConversionType.FirstAndLast}" />
                                    <Binding Path="Person"/>
                                </MultiBinding>
                            </Label.Content>
                        </Label>
                        <Label FontSize="14" Content="{Binding Person.NickName}" Foreground="{StaticResource MutedBlueBrush}" Padding="2,0,2,2"/>
                        <Label FontSize="18" Content="Log of all events" Padding="2"/>
                        <Label FontSize="14" Content="D-click row to see event details" Foreground="{StaticResource MutedBlueBrush}" Padding="2"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Summaries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:SummaryGrid Label="{Binding Label}" RacerData="{Binding RacerData}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <DataGrid x:Name="gridParticipants"
                  Grid.Row="1"
                  ItemsSource="{Binding AllEventRows}"
                  IsSynchronizedWithCurrentItem="False"
                  FontSize="24" AutoGenerateColumns="False" GridLinesVisibility="All" HorizontalAlignment="Stretch"
                  CanUserAddRows="False"
                  CanUserSortColumns="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource ThemedDataGridRow}">
                    <EventSetter Event="MouseDoubleClick" Handler="OnEventRowDoubleClick"/>
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RacerLapsTooltipTemplate}"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="colEventName" CanUserResize="True" Width="3*" Header="Name" IsReadOnly="true" MinWidth="50"
                                    Binding="{Binding Event.EventName}"
                                    HeaderStyle="{StaticResource DataGridHeaderLeft}"
                                    ElementStyle="{StaticResource DataGridCellLeft}"/>

                <DataGridTextColumn x:Name="colLaps" CanUserResize="False" Width="1.1*" Header="Total Laps" IsReadOnly="true" MinWidth="15"
                                    Binding="{Binding RacerData.Laps.Count}"
                                    HeaderStyle="{StaticResource DataGridHeaderRight}"
                                    ElementStyle="{StaticResource DataGridCellRight}"/>

                <DataGridTextColumn x:Name="colDistance" CanUserResize="False" Width="2*" Header="Total Distance" IsReadOnly="true" MinWidth="50"
                                    HeaderStyle="{StaticResource DataGridHeaderRight}"
                                    ElementStyle="{StaticResource DataGridCellRight}">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource Laps2DistanceConverter}">
                            <Binding Path="RacerData.Laps" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="colTotalTime" CanUserResize="False" Width="2*" Header="Total Time" IsReadOnly="true" MinWidth="50"
                                    HeaderStyle="{StaticResource DataGridHeaderRight}"
                                    ElementStyle="{StaticResource DataGridCellRight}">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource Laps2TimeConverter}">
                            <Binding Source="{x:Static converters:TimeConversionType.TotalTime}" />
                            <Binding Path="RacerData.Laps"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="colFastestLap" CanUserResize="False" Width="2*" Header="Best Lap" IsReadOnly="true" MinWidth="50"
                                    HeaderStyle="{StaticResource DataGridHeaderRight}"
                                    ElementStyle="{StaticResource DataGridCellRight}">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource Laps2TimeConverter}">
                            <Binding Source="{x:Static converters:TimeConversionType.BestLap}" />
                            <Binding Path="RacerData.Laps"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="colAverageLap" CanUserResize="False" Width="2*" Header="Average Lap" IsReadOnly="true" MinWidth="50"
                                    HeaderStyle="{StaticResource DataGridHeaderRight}"
                                    ElementStyle="{StaticResource DataGridCellRight}">
                    <DataGridTextColumn.Binding>
                        <MultiBinding Converter="{StaticResource Laps2TimeConverter}">
                            <Binding Source="{x:Static converters:TimeConversionType.AverageLap}" />
                            <Binding Path="RacerData.Laps"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="btnExportHtml"
                Content="Export HTML"
                Grid.Row="2"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="48" Width="120"
                Command="{Binding ExportHtmlCommand}" Margin="0,8,12,8"
                Style="{StaticResource GlossyBeveledButton}"/>
    </Grid>
</UserControl>
