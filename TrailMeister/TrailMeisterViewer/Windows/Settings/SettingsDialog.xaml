<Window x:Class="TrailMeisterViewer.Windows.Settings.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Export -->
        <GroupBox Grid.Row="0" Header="Export" Padding="8,4" Margin="0,0,0,8" FontSize="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Content="Output Directory:" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="tbOutputDir" Grid.Column="1" FontSize="14"
                         Margin="8,4,4,4" VerticalAlignment="Center"/>
                <Button x:Name="btnBrowse" Grid.Column="2" Content="Browse"
                        Width="72" Height="30" Margin="0,4,0,4"
                        Click="OnBrowse" Style="{StaticResource DialogButton}"/>
            </Grid>
        </GroupBox>

        <!-- Database -->
        <GroupBox Grid.Row="1" Header="Database" Padding="8,4" Margin="0,0,0,8" FontSize="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Server:" Grid.Row="0" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="tbDbServer"   Grid.Row="0" Grid.Column="1" FontSize="14" Margin="0,3"/>

                <Label Content="Database:" Grid.Row="1" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="tbDbName"     Grid.Row="1" Grid.Column="1" FontSize="14" Margin="0,3"/>

                <Label Content="User ID:" Grid.Row="2" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="tbDbUserId"   Grid.Row="2" Grid.Column="1" FontSize="14" Margin="0,3"/>

                <Label Content="Password:" Grid.Row="3" VerticalAlignment="Center" FontSize="14"/>
                <PasswordBox x:Name="pbDbPassword" Grid.Row="3" Grid.Column="1" FontSize="14" Margin="0,3"/>
            </Grid>
        </GroupBox>

        <!-- Handicap Algorithm -->
        <GroupBox Grid.Row="2" Header="Handicap Algorithm" Padding="8,4" Margin="0,0,0,8" FontSize="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Min lap length for handicap (m):" Grid.Row="0" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="tbHandicapMinLap" Grid.Row="0" Grid.Column="1" FontSize="14" Margin="0,3" TextAlignment="Right"/>

                <Label Content="Penalty per 100 m shorter (%):" Grid.Row="1" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="tbHandicapPenalty" Grid.Row="1" Grid.Column="1" FontSize="14" Margin="0,3" TextAlignment="Right"/>

                <Label Content="Maximum penalty (%):" Grid.Row="2" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="tbHandicapMaxPenalty" Grid.Row="2" Grid.Column="1" FontSize="14" Margin="0,3" TextAlignment="Right"/>
            </Grid>
        </GroupBox>

        <!-- Season -->
        <GroupBox Grid.Row="3" Header="Season" Padding="8,4" Margin="0,0,0,8" FontSize="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Season starts in:" VerticalAlignment="Center" FontSize="14"/>
                <ComboBox x:Name="cboSeasonMonth" Grid.Column="1" FontSize="14"
                          Margin="8,4,0,4" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Arduino / Reader -->
        <GroupBox Grid.Row="4" Header="Arduino / RFID Reader" Padding="8,4" Margin="0,0,0,8" FontSize="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="IP Address:" Grid.Row="0" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="tbArduinoIp"   Grid.Row="0" Grid.Column="1" FontSize="14" Margin="0,3"/>

                <Label Content="Port:" Grid.Row="1" VerticalAlignment="Center" FontSize="14"/>
                <TextBox x:Name="tbArduinoPort"  Grid.Row="1" Grid.Column="1" FontSize="14" Margin="0,3"/>
            </Grid>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="70" Click="OnCancel"
                    Margin="0,0,8,0" Style="{StaticResource DialogButton}"/>
            <Button Content="Save" Width="70" Click="OnSave"
                    Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </Grid>
</Window>
